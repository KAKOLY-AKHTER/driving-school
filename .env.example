# Public application URLs
CLIENT_URL=https://aprecisiondrivingschool.com

# Database and authentication
MONGO_URI=
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Contact and course-confirmation email delivery (server-only; never prefix these with VITE_)
RESEND_API_KEY=re_your_resend_api_key
CONTACT_FROM_EMAIL=A Precision Driving School <contact@aprecisiondrivingschool.com>
CONTACT_ADMIN_EMAIL=info@aprecision.com

# Blog image delivery (server-only; never expose the API secret with a VITE_ prefix)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox

# Google Calendar booking sync (server-only)
# Create a Google OAuth 2.0 Web application and enable the Calendar API.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=https://aprecisiondrivingschool.com/api/google-calendar/callback
# Generate a unique random secret of at least 32 characters. Never reuse the OAuth client secret.
GOOGLE_CALENDAR_TOKEN_SECRET=
GOOGLE_CALENDAR_TIME_ZONE=America/Los_Angeles
